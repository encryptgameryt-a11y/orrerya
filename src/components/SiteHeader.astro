---
interface Props { currentPath?: string }
const { currentPath = "/" } = Astro.props;
const links = [
  { href: "/solar-system/", label: "Atlas" },
  { href: "/planets/", label: "Planets" },
  { href: "/explore/", label: "Explore" },
  { href: "/tools/", label: "Tools" },
  { href: "/science/", label: "The science" }
];
---
<header class="site-header">
  <div class="container header-inner">
    <a class="wordmark" href="/" aria-label="ORRERYA home">
      <span class="wordmark-mark" aria-hidden="true">O<span>✦</span></span>
      <span>ORRERY<span class="wordmark-gold">A</span><small>SUN · PLANETS · MOONS</small></span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label="Open navigation" aria-haspopup="true">
      <span></span><span></span>
    </button>
    <nav id="primary-nav" class="primary-nav" aria-label="Primary navigation">
      {links.map((link) => <a href={link.href} class:list={{ active: currentPath.startsWith(link.href) }}>{link.label}</a>)}
      <a class="nav-cta" href="/about/">About ORRERYA <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>
<script is:inline src="/scripts/site-nav.js"></script>
