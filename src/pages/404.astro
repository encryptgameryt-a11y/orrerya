---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="Page not found" description="This ORRERYA page could not be found.">
  <section class="container not-found"><span class="eyebrow">404 · PAGE NOT FOUND</span><h1>Page not<br />found.</h1><p class="lede">We couldn't find that page. The address may be incorrect or the page may have moved.</p><div class="actions"><a class="btn" href="/">Return home ↗</a><a class="btn secondary" href="/planets/">Browse the planets</a></div></section>
  <style>.not-found{min-height:62vh;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding-top:50px;padding-bottom:70px}.not-found h1{font-size:clamp(3.4rem,9vw,6rem);margin:18px 0}.not-found .lede{max-width:560px}.not-found .actions{display:flex;gap:10px;flex-wrap:wrap}</style>
</SiteLayout>
