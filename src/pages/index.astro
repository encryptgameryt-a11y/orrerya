---
import SiteLayout from "../layouts/SiteLayout.astro";
import { planets } from "../data/planets";
import LineIcon from "../components/LineIcon.astro";
const featured = planets.slice(0, 4);
const outer = planets.slice(4);
const orbitalDisplay = planets.map((planet, index) => ({ ...planet, x: [275, 340, 405, 470, 650, 815, 975, 1135][index], size: [29, 34, 38, 31, 66, 62, 49, 49][index] }));
const homeSummaries: Record<string, string> = {
  mercury: "A small, crater-covered world that races around the Sun.",
  venus: "A bright world hidden by thick clouds, with crushing pressure and extreme heat.",
  earth: "Our ocean-covered home, with air, water and the only life we know.",
  mars: "A cold, red desert with giant volcanoes and signs of ancient rivers."
};
---
<SiteLayout title="ORRERYA" description="Explore the Sun, all eight planets, the Kuiper Belt and the many icy worlds beyond Neptune with ORRERYA.">

  <section class="home-hero orrery-home-hero">
    <div class="container orrery-home-inner">
      <div class="orrery-hero-head">
        <div class="orrery-brand-feature">
          <span class="eyebrow">NAVIGATE THE CELESTIAL FRONTIER</span>
          <h1 class="orrery-logo-title">ORRERYA</h1>
          <p class="orrery-brand-tag">THE SOLAR SYSTEM, EXPLAINED</p>
        </div>
        <div class="orrery-hero-intro">
          <p class="orrery-hero-line">The Mechanics of the Cosmos.</p>
          <p class="orrery-hero-description">Meet the Sun, eight planets and icy worlds beyond Neptune.</p>
          <div class="hero-actions">
            <a class="btn" href="/planets/">Meet the planets <span aria-hidden="true">↗</span></a>
            <a class="btn secondary" href="/explore/">Explore the system <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
      <div class="orrery-map-frame">
        <div class="orrery-map-topline">
          <span>OUR SOLAR SYSTEM</span>
          <span class="orrery-scroll-hint">SWIPE TO EXPLORE →</span>
        </div>
        <div class="orrery-map-scroll">
          <div class="orrery-map" role="group" aria-label="A schematic view of the Solar System showing the Sun, the eight planets in order, the asteroid belt between Mars and Jupiter, and the Kuiper Belt among trans-Neptunian objects. Planet sizes and orbital distances are not to scale.">
            <svg class="orrery-orbit-art" viewBox="0 0 1400 420" aria-hidden="true" focusable="false">
              <defs>
                <radialGradient id="orrery-sun-fill" cx="34%" cy="30%">
                  <stop offset="0%" stop-color="#fff6d9" />
                  <stop offset="24%" stop-color="#f9cb78" />
                  <stop offset="63%" stop-color="#e79542" />
                  <stop offset="100%" stop-color="#a95c32" />
                </radialGradient>
                <radialGradient id="orrery-sun-halo">
                  <stop offset="0%" stop-color="#e7a653" stop-opacity=".22" />
                  <stop offset="62%" stop-color="#e7a653" stop-opacity=".08" />
                  <stop offset="100%" stop-color="#e7a653" stop-opacity="0" />
                </radialGradient>
              </defs>
              <g class="orrery-orbits">
                <ellipse cx="110" cy="210" rx="165" ry="50" />
                <ellipse cx="110" cy="210" rx="230" ry="68" />
                <ellipse cx="110" cy="210" rx="295" ry="86" />
                <ellipse cx="110" cy="210" rx="360" ry="105" />
                <ellipse cx="110" cy="210" rx="540" ry="145" />
                <ellipse cx="110" cy="210" rx="705" ry="185" />
                <ellipse cx="110" cy="210" rx="865" ry="220" />
                <ellipse cx="110" cy="210" rx="1025" ry="255" />
              </g>
              <ellipse class="orrery-kuiper-orbit" cx="110" cy="210" rx="1125" ry="280" />
              <circle class="orrery-sun-halo" cx="110" cy="210" r="112" fill="url(#orrery-sun-halo)" />
              <circle class="orrery-sun-core" cx="110" cy="210" r="49" fill="url(#orrery-sun-fill)" />
              <circle class="orrery-sun-edge" cx="110" cy="210" r="54" />
              <g class="orrery-asteroid-points">
                <circle cx="568" cy="182" r="3.4"/><circle cx="580" cy="198" r="2.3"/><circle cx="592" cy="220" r="3"/>
                <circle cx="604" cy="174" r="2.2"/><circle cx="618" cy="202" r="4"/><circle cx="628" cy="235" r="2.4"/>
                <circle cx="642" cy="188" r="2.6"/><circle cx="653" cy="216" r="3.5"/><circle cx="665" cy="176" r="2.1"/>
                <circle cx="578" cy="246" r="2.1"/><circle cx="600" cy="257" r="3.1"/><circle cx="625" cy="164" r="1.8"/>
                <circle cx="646" cy="260" r="2.2"/><circle cx="670" cy="238" r="2.8"/><circle cx="687" cy="203" r="1.9"/>
                <circle cx="557" cy="215" r="1.8"/><circle cx="590" cy="157" r="2.3"/><circle cx="636" cy="146" r="1.8"/>
              </g>
              <g class="orrery-kuiper-points">
                <circle cx="1260" cy="147" r="2.6"/><circle cx="1281" cy="172" r="3.1"/><circle cx="1304" cy="195" r="2"/>
                <circle cx="1250" cy="223" r="2.1"/><circle cx="1292" cy="245" r="3.2"/><circle cx="1324" cy="213" r="2.2"/>
                <circle cx="1271" cy="278" r="2.5"/><circle cx="1306" cy="294" r="1.8"/><circle cx="1340" cy="262" r="2.6"/>
                <circle cx="1244" cy="310" r="1.9"/><circle cx="1284" cy="327" r="2.4"/><circle cx="1320" cy="342" r="1.8"/>
              </g>
              <g class="orrery-map-captions">
                <text x="110" y="326" text-anchor="middle">THE SUN</text>
                <text x="612" y="72" text-anchor="middle">ASTEROID BELT</text>
                <path d="M612 82 L612 126" />
                <text x="1252" y="82" text-anchor="middle">TRANS-NEPTUNIAN</text>
                <text x="1252" y="101" text-anchor="middle">OBJECTS</text>
                <path d="M1252 110 L1252 132" />
                <text x="1265" y="382" text-anchor="middle">KUIPER BELT</text>
              </g>
            </svg>
            {orbitalDisplay.map((item) => <div class="orrery-world" data-world={item.slug} style={"--world-x:" + (item.x / 14) + "%;--world-size:" + item.size + "px"}>
              <img src={item.image} alt={item.imageAlt} loading="lazy" decoding="async" />
              <span>{item.name}</span>
            </div>)}
          </div>
        </div>
        <div class="orrery-map-legend">
          <span><i class="legend-asteroid"></i> Asteroid Belt</span>
          <span><i class="legend-kuiper"></i> Kuiper Belt</span>
          <span class="legend-note">The Kuiper Belt is one part of the region beyond Neptune.</span>
        </div>
        <p class="orrery-map-note">Planet sizes and distances are simplified so you can see the whole system at a glance.</p>
      </div>
      <div class="orrery-hero-bottom">
        <span>START ANYWHERE</span><span class="line"></span>
        <a href="/explore/sun/">The Sun</a><span>·</span><a href="/planets/">The planets</a><span>·</span><a href="/explore/moons/">Moons & rings</a><span>·</span><a href="/science/">The science</a>
      </div>
    </div>
  </section>

  <section class="home-facts container" aria-label="Solar System at a glance">
    <div><strong>~4.6 <small>billion years</small></strong><span>How long ago the Solar System began to form</span></div>
    <div><strong>8 <small>planets</small></strong><span>Four rocky worlds and four giant planets</span></div>
    <div><strong>99.8% <small>of the mass</small></strong><span>The Sun holds almost all of it</span></div>
    <div><strong>149.6 <small>million km</small></strong><span>Earth's average distance from the Sun</span></div>
  </section>

  <section class="section container home-planets-section">
    <div class="section-head">
      <div><div class="eyebrow">01 / THE TERRESTRIAL WORLDS</div><h2>The Terrestrial Frontier.</h2></div>
      <div class="section-side"><p>Four rocky worlds. Infinite untold histories.</p><a class="text-link" href="/planets/">Explore all eight planets ↗</a></div>
    </div>
    <div class="home-planet-grid">
      {featured.map((planet) => <a class="planet-card home-planet-card" href={"/planets/" + planet.slug + "/"}><div class="planet-card-image"><img src={planet.image} alt={planet.imageAlt} loading="lazy" /></div><div class="planet-card-body"><span class="planet-card-kicker">PLANET {planet.order.toString().padStart(2, "0")}</span><h3>{planet.name}</h3><p>{homeSummaries[planet.slug] ?? planet.short}</p><span class="text-link">Explore {planet.name} ↗</span></div></a>)}
    </div>
    <div class="home-outer-band">
      <div class="outer-band-copy"><span class="eyebrow">02 / THE OUTER GIANTS</span><h3>Titans of the Outer Dark.</h3><p>Beyond the asteroid belt, two gas giants and two ice giants command the outer Solar System. Jupiter and Saturn are dominated by hydrogen and helium; Uranus and Neptune contain much larger proportions of heavier volatile compounds.</p><a class="text-link" href="/planets/#outer-planets">Meet the outer planets ↗</a></div>
      <div class="outer-mini-grid">{outer.map((planet) => <a href={"/planets/" + planet.slug + "/"}><img src={planet.image} alt={planet.imageAlt} loading="lazy" /><span>{planet.name}</span></a>)}</div>
    </div>
  </section>

  <section class="section home-discover">
    <div class="container">
      <div class="section-head"><div><div class="eyebrow">03 / THE WIDER SYSTEM</div><h2>Beyond the Familiar.</h2></div><p>From solar activity to hidden oceans, the science of our system is still unfolding.</p></div>

      <div class="discover-grid">
        <a class="discover-card sun-card" href="/explore/sun/"><span class="discover-number">01</span><span class="discover-icon"><LineIcon name="sun" size={28} /></span><div><span class="eyebrow">Our star</span><h3>The Sun</h3><p>The Sun gives us light and heat. It also creates magnetic storms and sends tiny particles into space.</p><span class="text-link">Meet our star ↗</span></div></a>
        <a class="discover-card" href="/explore/moons/"><span class="discover-number">02</span><span class="discover-icon"><LineIcon name="moon" size={28} /></span><div><span class="eyebrow">Worlds in orbit</span><h3>Moons & rings</h3><p>Some moons may hide oceans; others have active volcanoes or rings made from countless small pieces.</p><span class="text-link">Explore the moons ↗</span></div></a>
        <a class="discover-card" href="/explore/dwarf-planets/"><span class="discover-number">03</span><span class="discover-icon"><LineIcon name="planet" size={28} /></span><div><span class="eyebrow">Small worlds</span><h3>Dwarf planets</h3><p>Meet Pluto, Ceres, Haumea, Makemake and Eris, and see what makes them special.</p><span class="text-link">Meet the dwarf planets ↗</span></div></a>
        <a class="discover-card" href="/science/"><span class="discover-number">04</span><span class="discover-icon"><LineIcon name="orbit" size={28} /></span><div><span class="eyebrow">The big picture</span><h3>How it works</h3><p>See how gravity moves planets, why seasons change and how moons create tides.</p><span class="text-link">Explore the science ↗</span></div></a>
      </div>
      <a class="comets-banner" href="/explore/small-bodies/">
        <div class="comets-banner-art" role="img" aria-label="Illustration of a bright comet passing rocky asteroid fragments.">
          <svg viewBox="0 0 640 300" aria-hidden="true" focusable="false">
            <defs>
              <linearGradient id="comet-tail" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#f2d19a" stop-opacity="0" /><stop offset="72%" stop-color="#e9bc78" stop-opacity=".42" /><stop offset="100%" stop-color="#fff5dc" stop-opacity=".9" />
              </linearGradient>
              <radialGradient id="comet-head">
                <stop offset="0%" stop-color="#fffdf2" /><stop offset="45%" stop-color="#f5d38e" /><stop offset="100%" stop-color="#c78d4a" />
              </radialGradient>
            </defs>
            <g fill="none" stroke="#b9c9d4" stroke-opacity=".18"><path d="M0 65Q245 8 640 85M0 225Q275 150 640 240M55 0Q240 130 460 300" /></g>
            <path d="M78 196Q250 74 480 64Q330 122 175 222Z" fill="url(#comet-tail)" />
            <path d="M100 230Q265 126 475 82" fill="none" stroke="#f0d5a5" stroke-opacity=".48" stroke-width="2" />
            <circle cx="482" cy="65" r="16" fill="url(#comet-head)" /><circle cx="482" cy="65" r="25" fill="none" stroke="#e8c58d" stroke-opacity=".24" />
            <g fill="#8d969b" stroke="#d1d5d4" stroke-opacity=".45">
              <path d="M176 40l17-13 21 8 8 18-13 17-24-3-13-13Z" /><path d="M254 227l12-18 22-2 15 14-7 22-19 8-20-8Z" />
              <path d="M553 192l15-11 17 6 7 17-12 15-20-4-9-12Z" /><path d="M370 266l8-10 15 2 7 12-11 12-15-4Z" />
            </g>
            <g fill="#f5d7a2"><circle cx="105" cy="84" r="2"/><circle cx="142" cy="258" r="1.5"/><circle cx="331" cy="31" r="1.7"/><circle cx="575" cy="42" r="1.8"/><circle cx="610" cy="137" r="1.4"/><circle cx="54" cy="170" r="1.4"/></g>
          </svg>
        </div>
        <div class="comets-banner-copy">
          <span class="eyebrow">04 / PRIMORDIAL REMNANTS</span><h3>Relics of Creation.</h3>
          <p>Rocky asteroids and ice-rich comets preserve clues from the Solar System’s formation.</p>
          <span class="text-link">Explore comets & asteroids ↗</span>
        </div>
      </a>
      <section class="distant-worlds" aria-labelledby="distant-worlds-title">
        <div class="distant-worlds-heading">
          <div><span class="eyebrow">05 / THE TRANS-NEPTUNIAN FRONTIER</span><h3 id="distant-worlds-title">The Kuiper Frontier.</h3><p>Beyond Neptune, icy worlds orbit in the Sun’s distant light. The Kuiper Belt is one part of the wider trans-Neptunian region.</p></div>
          <span class="carousel-hint">SCROLL TO EXPLORE <span aria-hidden="true">→</span></span>
        </div>
        <div class="distant-worlds-track" role="region" aria-label="Distant icy worlds. Scroll sideways to explore." tabindex="0">
          <a class="distant-world-card" href="/explore/small-bodies/"><span class="distant-world-number">01</span><LineIcon name="orbit" size={26} /><h4>The Kuiper Belt</h4><p>A wide ring of icy objects beyond Neptune.</p><span class="text-link">Explore the Kuiper Belt ↗</span></a>
          <a class="distant-world-card" href="/explore/dwarf-planets/"><span class="distant-world-number">02</span><LineIcon name="planet" size={26} /><h4>Pluto</h4><p>A small icy world with mountains, glaciers and five moons.</p><span class="text-link">Meet Pluto ↗</span></a>
          <a class="distant-world-card" href="/explore/dwarf-planets/"><span class="distant-world-number">03</span><LineIcon name="planet" size={26} /><h4>Eris</h4><p>A faraway dwarf planet with a small moon of its own.</p><span class="text-link">Explore dwarf planets ↗</span></a>
          <a class="distant-world-card" href="/explore/small-bodies/"><span class="distant-world-number">04</span><LineIcon name="moon" size={26} /><h4>Many more worlds</h4><p>Many smaller icy objects travel around the Sun far beyond Neptune.</p><span class="text-link">Explore distant objects ↗</span></a>
        </div>
      </section>
    </div>
  </section>

  <section class="section container">
    <div class="section-head"><div><div class="eyebrow">03 / TRY IT YOURSELF</div><h2>See how the Solar System works.</h2></div><p>Try quick calculators and experiments to compare worlds and see how gravity, distance and orbits work.</p></div>

    <div class="tool-preview-grid">
      <a class="tool-preview" href="/tools/#weight"><span class="tool-index">TOOL 01</span><span class="tool-symbol"><LineIcon name="scale" size={27} /></span><h3>Your weight on other worlds</h3><p>See how your weight would change under another world's gravity.</p><span class="text-link">Open calculator ↗</span></a>
      <a class="tool-preview" href="/tools/#distance"><span class="tool-index">TOOL 02</span><span class="tool-symbol"><LineIcon name="ruler" size={27} /></span><h3>Space distance converter</h3><p>Turn huge space distances into kilometres and light-travel time.</p><span class="text-link">Open converter ↗</span></a>
      <a class="tool-preview" href="/tools/#compare"><span class="tool-index">TOOL 03</span><span class="tool-symbol"><LineIcon name="planet" size={27} /></span><h3>Compare planet sizes</h3><p>See how big each planet is compared with Earth.</p><span class="text-link">Open comparison ↗</span></a>
      <a class="tool-preview" href="/tools/#year"><span class="tool-index">TOOL 04</span><span class="tool-symbol"><LineIcon name="calendar" size={27} /></span><h3>How long is a year?</h3><p>Compare how long each planet takes to travel around the Sun.</p><span class="text-link">Open year calculator ↗</span></a>
      <a class="tool-preview" href="/tools/#orbit"><span class="tool-index">TOOL 05</span><span class="tool-symbol"><LineIcon name="orbit" size={27} /></span><h3>Try an orbit</h3><p>Move a planet along its path and watch its distance and speed change.</p><span class="text-link">Open orbit lab ↗</span></a>
      <a class="tool-preview" href="/tools/ephemeris/"><span class="tool-index">TOOL 06</span><span class="tool-symbol"><LineIcon name="compass" size={27} /></span><h3>Where are the planets?</h3><p>Choose a date and see where the planets appear around the Sun.</p><span class="text-link">Open position explorer ↗</span></a>
    </div>
    </div>
  </section>
  <section class="container home-endcap"><div><span class="eyebrow">Keep looking up</span><h2>Curiosity is a good<br />place to start.</h2><p>Choose a world. Ask a question. Follow the evidence.</p></div><a class="btn" href="/planets/">Enter the encyclopedia ↗</a></section>
  <style>
    .home-hero{position:relative;overflow:hidden;border-bottom:1px solid var(--line);background:radial-gradient(ellipse at 77% 47%,rgba(33,66,111,.34),transparent 37rem),linear-gradient(180deg,rgba(13,23,39,.25),transparent)}
    .home-hero-grid{display:grid;grid-template-columns:1.03fr .97fr;gap:25px;align-items:center;min-height:610px;padding-top:35px;padding-bottom:35px}
    .home-copy{position:relative;z-index:2;padding:30px 0}
    .eyebrow-line{display:inline-block;width:28px;height:1px;background:var(--gold);vertical-align:middle;margin-right:8px}
    .home-copy h1{font-size:clamp(3.2rem,7.4vw,6.4rem);margin:26px 0 22px}
    .home-copy h1 em{color:var(--gold);font-style:normal}
    .home-copy .lede{max-width:555px}
    .hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:29px}
    .home-proof{margin-top:36px;color:var(--quiet);font-size:.73rem;letter-spacing:.05em}
    .proof-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--cyan);box-shadow:0 0 10px var(--cyan);margin-right:8px}
    .home-art{position:relative;height:515px;display:grid;place-items:center;isolation:isolate}
    .home-sun-glow{position:absolute;width:280px;height:280px;border-radius:50%;background:radial-gradient(circle,rgba(232,174,93,.18),rgba(232,174,93,.06) 45%,transparent 70%);filter:blur(18px)}
    .home-sun{width:112px;height:112px;position:relative;border-radius:50%;background:radial-gradient(circle at 32% 26%,#fff4c7,#f6c36f 28%,#db8e43 66%,#8c492b 100%);box-shadow:0 0 40px rgba(241,181,89,.48),0 0 100px rgba(229,157,71,.21);z-index:4}
    .home-sun span{position:absolute;inset:-11px;border-radius:50%;border:1px solid rgba(239,191,119,.24)}
    .home-orbit{position:absolute;border:1px solid rgba(193,210,237,.15);border-radius:50%;transform:rotate(-24deg)}
    .home-orbit i{position:absolute;display:block;border-radius:50%;background:var(--dot);box-shadow:0 0 17px var(--dot);width:11px;height:11px;left:12%;top:11%}
    .orbit-a{width:190px;height:116px;--dot:#aeb4bd}.orbit-a i{width:5px;height:5px;left:9%;top:27%}
    .orbit-b{width:270px;height:166px;--dot:#d9a976}.orbit-b i{width:8px;height:8px;left:84%;top:65%}
    .orbit-c{width:360px;height:222px;--dot:#3d8fc5}.orbit-c i{width:10px;height:10px;left:20%;top:91%}
    .orbit-d{width:470px;height:290px;--dot:#c77c5d}.orbit-d i{width:8px;height:8px;left:88%;top:18%}
    .orbit-e{width:570px;height:350px;--dot:#a7b5d6}.orbit-e i{width:14px;height:14px;left:45%;top:-2%}
    .home-art-note{position:absolute;bottom:16px;right:0;color:var(--quiet);font-size:.65rem;letter-spacing:.1em;text-transform:uppercase}
    .home-art-label{position:absolute;top:28px;right:8px;color:#8e9db3;font-size:.68rem;letter-spacing:.14em}
    .home-art-label span{color:var(--gold);margin-right:8px}
    .home-hero-bottom{display:flex;align-items:center;gap:13px;padding:13px 0 18px;border-top:1px solid var(--line);color:var(--quiet);font-size:.68rem;letter-spacing:.1em}
    .home-hero-bottom a{color:#c0cada;font-size:.74rem;letter-spacing:0}
    .home-hero-bottom .line{height:1px;max-width:70px;flex:1;background:var(--line-strong)}
    .home-facts{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid var(--line);padding:24px 0}
    .home-facts>div{padding:0 22px;border-right:1px solid var(--line)}
    .home-facts>div:first-child{padding-left:0}.home-facts>div:last-child{border:0}
    .home-facts strong{display:block;color:var(--gold-bright);font:600 clamp(1.45rem,2.8vw,2rem) "Space Grotesk",sans-serif;letter-spacing:-.04em;line-height:1.2}
    .home-facts strong small{font-size:.72rem;font-weight:500;color:var(--muted);letter-spacing:0}
    .home-facts span{display:block;margin-top:7px;color:var(--quiet);font-size:.75rem;line-height:1.5}
    .heading-muted{color:#8392a8}
    .section-side{max-width:420px}.section-side p{margin:0 0 12px}
    .home-planet-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
    .home-outer-band{display:grid;grid-template-columns:.8fr 1.2fr;gap:24px;margin-top:18px;padding:24px;background:linear-gradient(110deg,#14243a,#0b1423);border:1px solid var(--line);border-radius:8px}
    .outer-band-copy h3{font:600 1.45rem/1.2 "Space Grotesk",sans-serif;margin:12px 0}
    .outer-band-copy p{font-size:.82rem;line-height:1.7}
    .outer-mini-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}
    .outer-mini-grid a{position:relative;min-height:115px;overflow:hidden;border-radius:5px;border:1px solid var(--line)}
    .outer-mini-grid img{width:100%;height:100%;position:absolute;object-fit:cover;opacity:.73;transition:transform .3s}
    .outer-mini-grid a:hover img{transform:scale(1.05);opacity:1}
    .outer-mini-grid span{position:absolute;bottom:8px;left:9px;z-index:1;font-size:.73rem;font-weight:700;text-shadow:0 1px 7px #000}
    .section.home-discover{background:linear-gradient(180deg,rgba(16,27,45,.65),rgba(8,13,24,.25));border-block:1px solid var(--line)}
    .discover-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}
