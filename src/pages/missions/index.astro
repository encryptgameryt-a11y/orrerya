---
import SiteLayout from "../../layouts/SiteLayout.astro";
const missions = [
  {year:"1974",name:"Mariner 10",target:"Mercury & Venus",detail:"The first spacecraft to use a gravity-assist manoeuvre at Venus to reach another planet. It made three Mercury flybys and revealed a globally cratered world."},
  {year:"1977",name:"Voyager 1 & 2",target:"Jupiter, Saturn and beyond",detail:"The twin spacecraft transformed knowledge of the giant planets and their moons. They continue on trajectories through interstellar space."},
  {year:"1989",name:"Galileo",target:"Jupiter",detail:"Orbited Jupiter, studied its magnetosphere and atmosphere, and transformed knowledge of the Galilean moons. Its probe sampled Jupiter's atmosphere."},
  {year:"1997",name:"Cassini–Huygens",target:"Saturn & Titan",detail:"Cassini orbited Saturn from 2004 to 2017. Huygens descended through Titan's atmosphere and landed on its surface in 2005."},
  {year:"2004",name:"MESSENGER",target:"Mercury",detail:"Orbited Mercury from 2011 to 2015, mapping its surface and investigating its composition, magnetic field and exosphere."},
  {year:"2007",name:"Dawn",target:"Vesta & Ceres",detail:"Used ion propulsion to orbit two major bodies in the asteroid belt, revealing their distinct histories and interior evolution."},
  {year:"2006",name:"New Horizons",target:"Pluto & Kuiper Belt",detail:"Flew past Pluto in 2015 and Arrokoth in 2019, revealing the diversity of distant icy worlds and primitive planetesimals."},
  {year:"2011",name:"Juno",target:"Jupiter",detail:"Entered Jupiter orbit in 2016 to investigate its gravity, magnetic field, atmospheric circulation and deep interior."},
  {year:"2018",name:"Parker Solar Probe",target:"The Sun",detail:"Flies through the Sun's outer atmosphere, studying the corona and the origin and evolution of the solar wind."},
  {year:"2020",name:"OSIRIS-REx",target:"Asteroid Bennu",detail:"Collected a sample from near-Earth asteroid Bennu and returned it to Earth in 2023 for laboratory analysis."},
  {year:"2020",name:"Perseverance",target:"Mars",detail:"Explores Jezero crater, studies rocks and ancient environments, and collects samples for possible future return to Earth."}
];
---
<SiteLayout title="Exploring the Solar System" description="A timeline of landmark spacecraft missions that explored the Sun, planets, moons, asteroids and distant icy worlds.">
  <div class="container breadcrumbs"><a href="/">Home</a><span aria-hidden="true">/</span><span>Exploration</span></div>
  <header class="page-intro container"><div class="eyebrow">Robots, telescopes & human curiosity</div><h1>We went looking.<br />The Solar System answered.</h1><p class="lede">Every spacecraft is a scientific instrument and a messenger. These selected missions changed what we know about the Sun, planets, moons, asteroids and the distant frontier.</p></header>
  <section class="section container">
    <div class="mission-intro"><div class="card mission-stat"><span class="eyebrow">A changing method</span><strong>Flyby → Orbit → Land → Sample</strong><p>Exploration has moved from brief encounters to long-term orbital science, surface operations and the return of pristine extraterrestrial material.</p></div><div class="prose"><p>Mission dates below refer to launch years. They are arranged as a selected learning timeline, not a complete catalogue. Some missions are ongoing and mission status can change; follow the primary mission pages for current operations.</p></div></div>
    <div class="timeline">{missions.map((mission,i)=><article class="timeline-item"><div class="timeline-marker"><span>{mission.year}</span></div><div class="timeline-card"><span class="eyebrow">{mission.target}</span><h3>{mission.name}</h3><p>{mission.detail}</p></div></article>)}</div>
    <div class="callout"><strong>Not all discoveries come from spacecraft.</strong><p>Earth-based observatories, space telescopes, radar systems, laboratory meteorite analysis and computer simulations all contribute to modern planetary science. Measurements are strongest when independent methods agree.</p></div>
    <div class="source-panel"><div><span class="eyebrow">Mission databases</span><h3>Go straight to the source</h3><p>Mission science pages and agency mission catalogues are the best place for current details.</p></div><ul class="source-list"><li><a href="https://science.nasa.gov/solar-system/" target="_blank" rel="noreferrer">NASA — Solar System exploration ↗</a></li><li><a href="https://science.nasa.gov/mission/" target="_blank" rel="noreferrer">NASA — Mission directory ↗</a></li><li><a href="https://www.esa.int/Science_Exploration/Space_Science" target="_blank" rel="noreferrer">ESA — Space Science ↗</a></li><li><a href="https://www.jaxa.jp/projects/index_e.html" target="_blank" rel="noreferrer">JAXA — Space projects ↗</a></li></ul></div>
  </section>
  <style>.mission-intro{display:grid;grid-template-columns:.9fr 1.1fr;gap:28px;align-items:center;margin-bottom:50px}.mission-stat{padding:23px}.mission-stat strong{display:block;font:600 1.7rem "Space Grotesk",sans-serif;color:var(--gold-bright);margin:14px 0}.mission-stat p{font-size:.82rem;line-height:1.7;margin:0}.mission-intro .prose p{margin:0}.timeline{max-width:860px;margin-left:9px}.timeline-item{display:grid;grid-template-columns:85px 1fr;gap:24px;position:relative;padding-bottom:24px}.timeline-item:not(:last-child)::before{content:"";position:absolute;top:26px;bottom:-1px;left:24px;border-left:1px solid rgba(230,200,142,.3)}.timeline-marker{position:relative;z-index:1;display:flex;justify-content:center}.timeline-marker span{font:600 .86rem "Space Grotesk",sans-serif;color:var(--gold);background:var(--space);padding-top:8px}.timeline-card{padding:20px 22px;border:1px solid var(--line);border-radius:7px;background:rgba(16,27,45,.7)}.timeline-card h3{font:600 1.3rem "Space Grotesk",sans-serif;margin:7px 0}.timeline-card p{font-size:.84rem;line-height:1.7;margin:0}.callout{margin-top:28px}.source-panel{margin-top:38px}@media(max-width:700px){.mission-intro{grid-template-columns:1fr}.timeline-item{grid-template-columns:58px 1fr;gap:13px}.timeline-item:not(:last-child)::before{left:17px}.timeline-card{padding:16px}}</style>
</SiteLayout>
