---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { satellitePhysical, satelliteDerived } from "../../data/solar-system";
const moons = [
  { name:"The Moon", host:"Earth", role:"Our nearest natural satellite", detail:"A differentiated rocky world whose formation is strongly linked to a giant impact early in Earth's history. Its gravity raises ocean tides and its surface preserves an ancient impact record." },
  { name:"Phobos", host:"Mars", role:"A tiny, close-orbiting moon", detail:"An irregular body that orbits Mars very close to the planet. Tidal forces are slowly changing its orbit, and it may eventually break up or impact Mars." },
  { name:"Deimos", host:"Mars", role:"A small outer companion", detail:"Smaller and more distant than Phobos, Deimos is an irregular moon with a heavily cratered surface." },
  { name:"Io", host:"Jupiter", role:"The most volcanically active known world", detail:"Powerful tidal heating driven by Jupiter and orbital resonances with Europa and Ganymede energise hundreds of volcanoes." },
  { name:"Europa", host:"Jupiter", role:"A leading ocean-world target", detail:"A water-ice shell covers a global salty ocean inferred from magnetic and geological evidence. Its potential habitability is a major scientific question." },
  { name:"Ganymede", host:"Jupiter", role:"The largest moon in the Solar System", detail:"Ganymede is larger than Mercury and has its own intrinsic magnetic field. Evidence points to a deep subsurface ocean." },
  { name:"Callisto", host:"Jupiter", role:"An ancient, heavily cratered world", detail:"Its ancient surface preserves an extensive impact record. Data suggest a possible subsurface ocean beneath its icy exterior." },
  { name:"Titan", host:"Saturn", role:"A moon with a thick atmosphere", detail:"Titan has lakes, seas and rivers of liquid methane and ethane, weather, dunes and a nitrogen-rich atmosphere. It is an extraordinary natural laboratory for prebiotic chemistry." },
  { name:"Enceladus", host:"Saturn", role:"An active ocean moon", detail:"Jets erupt from fractures near its south pole, carrying water-rich material from a subsurface ocean into space. Cassini sampled the plume." },
  { name:"Triton", host:"Neptune", role:"A captured-world candidate", detail:"Triton orbits Neptune in a retrograde direction. Its unusual orbit and surface suggest it may have been captured from the outer Solar System." },
  { name:"Charon", host:"Pluto", role:"A large companion in a binary-like system", detail:"Charon is so large relative to Pluto that the pair orbit a shared centre of mass outside Pluto's body. The system is often described as a binary dwarf-planet system." }
];
---
<SiteLayout title="Moons and rings" description="Meet remarkable Solar System moons: Europa, Titan, Enceladus, Io, Ganymede, Triton and more. Learn how planetary rings work.">
  <div class="container breadcrumbs"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/explore/">Explore</a><span aria-hidden="true">/</span><span>Moons & rings</span></div>
  <header class="page-intro container"><div class="eyebrow">MOONS AND RINGS</div><h1>Moons of the Solar System.</h1><p class="lede">Some moons have atmospheres, volcanoes, magnetic fields or possible oceans beneath their icy crusts. Tides help shape many of these environments.</p></header>
  <aside class="container callout moon-count-note" aria-label="Current moon catalogue count">
    <strong>Catalogue snapshot · 4 November 2026</strong>
    <p>NASA reports 461 officially recognised moons orbiting the eight planets and dwarf planet Pluto. The JPL Solar System Dynamics catalogue listed 461 planetary satellites on 4 November 2026. Hundreds of additional moons are confirmed around asteroids and other small bodies, so 461 is not a count of every natural satellite in the Solar System.</p>
    <p><a href="https://ssd.jpl.nasa.gov/sats/" target="_blank" rel="noreferrer">JPL Planetary Satellites catalogue ↗</a> · <a href="https://science.nasa.gov/solar-system/moons/facts/" target="_blank" rel="noreferrer">NASA Moons: Facts ↗</a></p>
  </aside>
  <section class="section container">
    <div class="section-head"><div><div class="eyebrow">SELECTED NATURAL SATELLITES</div><h2>Explore notable moons.</h2></div><p>This is a curated starting set, not a complete moon catalogue. Confirmed moon totals change as new discoveries are announced and objects are re-observed.</p></div>
    <div class="moon-grid">{moons.map((moon, i) => <article class="card moon-card"><div class="moon-index">{String(i+1).padStart(2,"0")} <span>ORBITING {moon.host.toUpperCase()}</span></div><h3>{moon.name}</h3><span class="tag">{moon.role}</span><p>{moon.detail}</p></article>)}</div>

    <section class="moon-reference">
      <div class="section-head"><div><span class="eyebrow">JPL PHYSICAL PARAMETERS</span><h2>Physical properties of selected moons.</h2></div><p>Mass, gravitational acceleration at an equivalent-volume mean radius, and idealised spherical escape speed below are derived from JPL's gravitational parameter (GM) and mean radius. These are reference values, not local measurements; for irregular bodies, local gravity and escape conditions vary with shape, rotation and position.</p></div>
      <div class="table-wrap"><table class="moon-physical-table">
        <thead><tr><th>Moon</th><th>Orbits</th><th>GM solution</th><th>Mean radius</th><th>Mass (derived)</th><th>Mean density (derived)</th><th>Gravity at mean radius (derived)</th><th>Spherical escape speed (derived)</th></tr></thead>
        <tbody>{satellitePhysical.map((m) => { const d = satelliteDerived(m); return <tr><th>{m.name}</th><td>{m.host}</td><td><code>{m.gmReference}</code></td><td>{m.meanRadiusKm.toLocaleString("en-US")} km</td><td>{d.massKg.toExponential(3)} kg</td><td>{d.densityGcm3.toFixed(3)} g/cm³</td><td>{d.gravityMS2.toFixed(3)} m/s²</td><td>{d.escapeVelocityKmS.toFixed(3)} km/s</td></tr>; })}</tbody>
      </table></div>
      <p class="moon-reference-note">The GM solution column identifies the JPL ephemeris solution supplying each satellite's gravitational parameter (for example, DE440, MAR097 or JUP365). Mass is estimated as GM/G using G = 6.67430 × 10⁻²⁰ km³ kg⁻¹ s⁻² (2022 CODATA). Mean density is then derived from that mass and the equivalent-volume sphere, ρ = M / (4πr³/3). Gravity and escape speed use the spherical reference formulas GM/r² and √(2GM/r), with the JPL mean radius as r. These are reference values, not local measurements: irregular shape, rotation, topography and gravity anomalies are not modelled. Point estimates are rounded and formal GM/radius uncertainties are not propagated. The list is a selected major-moon sample, not every known natural satellite. <a href="https://ssd.jpl.nasa.gov/sats/phys_par/" target="_blank" rel="noreferrer">Open JPL's satellite parameter database ↗</a></p>
      <p class="moon-reference-note"><strong>Data-quality note — Charon:</strong> JPL's current table lists Charon's GM as 106.1 km³/s² and mean radius as 606.0 km, but its displayed density value of 1.853 g/cm³ is not reproducible from those two inputs. ORRERYA therefore derives the value from GM and radius (about 1.705 g/cm³), consistent with the New Horizons image-based result of 1.701 ± 0.033 g/cm³. See the <a href="https://doi.org/10.1016/j.icarus.2016.06.027" target="_blank" rel="noreferrer">2017 Icarus paper ↗</a> and <a href="https://ssd.jpl.nasa.gov/sats/phys_par/" target="_blank" rel="noreferrer">JPL parameter table ↗</a>.</p>
      <figure class="moon-feature-photo"><img src="https://assets.science.nasa.gov/dynamicimage/assets/science/psd/photojournal/pia/pia24/pia24681/jpeg/PIA24681.jpg?w=989&h=1536&fit=clip&crop=faces%2Cfocalpoint" alt="JunoCam image of Jupiter's moon Ganymede acquired during the June 2021 close flyby." loading="lazy"/><figcaption>Ganymede · NASA JunoCam · June 7, 2021. This preliminary JunoCam view was acquired through the green filter; it is not a complete natural-colour image. NASA/JPL-Caltech/SwRI/MSSS.</figcaption></figure>
    </section>
    <div class="prose moon-prose">
      <h2>How do moons form?</h2>
      <p>Natural satellites have several possible origins. Some formed from discs of material around their host planet while it was assembling. Others may be fragments from giant impacts, captured objects that passed too close, or bodies altered by later collisions. A moon's orbit, composition and geology provide clues to its history.</p>
      <h2>How tidal heating works inside moons</h2>
      <p>When a moon follows an eccentric orbit, the gravitational pull from its planet changes during each orbit. The moon is flexed and squeezed. Internal friction can convert some of that mechanical energy into heat. Orbital resonances can maintain the eccentricity and keep tidal heating going. Io is the dramatic volcanic example; Europa and Enceladus are important ocean-world examples.</p>
      <h2>What are planetary rings?</h2>
      <p>Rings are collections of countless particles orbiting a planet, mostly in a thin disc. Saturn's rings are bright and extensive, but Jupiter, Uranus and Neptune also have ring systems. Ring particles may be dust, ice or rocky material, and their distribution is shaped by collisions, gravity and resonances with moons.</p>
      <div class="callout"><strong>Moons such as Europa, Titan, Enceladus and Io have environments and geology unlike anything on Earth's surface.</strong><p>Europa's hidden ocean, Titan's hydrocarbon lakes, Enceladus's plume and Io's volcanoes show why planetary science increasingly treats moons as major destinations rather than footnotes.</p></div>
    </div>
    <div class="source-panel"><div><span class="eyebrow">Further reading</span><h3>FURTHER READING</h3><p>NASA's mission records and planetary science pages are good starting points for moon and ring research.</p></div><ul class="source-list"><li><a href="https://science.nasa.gov/solar-system/moons/" target="_blank" rel="noreferrer">NASA — Moons of the Solar System ↗</a></li><li><a href="https://science.nasa.gov/jupiter/moons/" target="_blank" rel="noreferrer">NASA — Jupiter's moons ↗</a></li><li><a href="https://science.nasa.gov/saturn/moons/" target="_blank" rel="noreferrer">NASA — Saturn's moons ↗</a></li><li><a href="https://science.nasa.gov/solar-system/rings/" target="_blank" rel="noreferrer">NASA — Planetary rings ↗</a></li></ul></div>
  </section>
  <style>.moon-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.moon-card{padding:21px}.moon-index{color:var(--gold);font-size:.69rem;letter-spacing:.12em}.moon-index span{color:var(--quiet);margin-left:8px}.moon-card h3{font:600 1.4rem "Space Grotesk",sans-serif;margin:13px 0 10px}.moon-card p{font-size:.83rem;line-height:1.75;margin:13px 0 0}.moon-prose{margin-top:60px}.source-panel{margin-top:40px}@media(max-width:850px){.moon-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:520px){.moon-grid{grid-template-columns:1fr}}</style>

  <style>
    .moon-reference{margin:52px 0}
    .moon-physical-table{width:100%;min-width:1050px;border-collapse:collapse;background:#fff;font-variant-numeric:tabular-nums}
    .moon-physical-table th,.moon-physical-table td{padding:10px 12px;text-align:left;border-bottom:1px solid #e3e9ed;font-size:.73rem}
    .moon-physical-table thead th{background:#edf2f5;color:#51677b;text-transform:uppercase;font-size:.65rem;letter-spacing:.06em}
    .moon-physical-table tbody th{color:#173b55}.moon-physical-table tbody td{color:#536a7e}
    .moon-reference-note{font-size:.73rem;color:#60778a;line-height:1.7;margin:12px 0}.moon-reference-note a{color:#1b5d82}
    .moon-feature-photo{margin:24px 0 0;background:#0a1725;border-radius:9px;overflow:hidden}
    .moon-feature-photo img{width:100%;max-height:440px;object-fit:contain;display:block}
    .moon-feature-photo figcaption{padding:10px 14px;color:#c5d0da;font-size:.7rem}
  </style>
</SiteLayout>
