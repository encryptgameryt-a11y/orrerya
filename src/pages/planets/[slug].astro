---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { planets } from "../../data/planets";

export function getStaticPaths() {
  return planets.map((planet) => ({ params: { slug: planet.slug }, props: { planet } }));
}
const { planet } = Astro.props;
const previous = planets[planet.order - 2];
const next = planets[planet.order];
---
<SiteLayout title={planet.name} description={planet.short} image={planet.image}>
  <div class="container">
    <div class="breadcrumbs"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/planets/">Planets</a><span aria-hidden="true">/</span><span>{planet.name}</span></div>
    <section class="hero-split planet-hero">
      <div>
        <div class="eyebrow">{planet.order.toString().padStart(2, "0")} / 08 · {planet.className}</div>
        <h1>{planet.name}</h1>
        <p class="lede">{planet.short}</p>
        <div class="hero-chips"><span class="tag">{planet.distance}</span><span class="tag">{planet.orbit} orbit</span></div>
        <div class="hero-actions"><a class="btn" href="/tools/#weight">Compare gravity on other worlds ↗</a><a class="btn secondary" href="/planets/">All planets</a></div>
      </div>
      <figure class="image-figure planet-feature-image"><div class="hero-image"><img src={planet.image} alt={planet.imageAlt} fetchpriority="high" /><span class="image-credit">Image: NASA · <a href={planet.imageSource} target="_blank" rel="noreferrer">image source ↗</a></span></div><figcaption>NASA imagery is presented for educational context. Processing and colour may vary by mission and instrument.</figcaption></figure>
    </section>
    <div class="stat-grid planet-stat-grid">
      <div class="stat"><span class="label">Equatorial diameter</span><strong>{planet.diameter}</strong><small>Planetary size</small></div>
      <div class="stat"><span class="label">Mass</span><strong>{planet.mass}</strong><small>Total mass</small></div>
      <div class="stat"><span class="label">Equatorial gravity</span><strong>{planet.gravity}</strong><small>Acceleration</small></div>
      <div class="stat"><span class="label">Year length</span><strong>{planet.orbit}</strong><small>One orbit around the Sun</small></div>
    </div>
  </div>
  <section class="section container planet-content">
    <div class="planet-content-grid">
      <article class="prose">
        <div class="eyebrow">A closer look</div><h2>About {planet.name}</h2>
        {planet.story.map((paragraph) => <p>{paragraph}</p>)}
        <div class="callout"><strong>Keep this distinction in mind</strong><p>{planet.highlight}</p></div>
        <h2>Inside the planet</h2><p>{planet.inside}</p>
        <h2>Atmosphere and environment</h2><p>{planet.atmosphere}</p>
        <h2>Magnetic environment</h2><p>{planet.magnetic}</p>
        <h2>Moons and rings</h2><p>{planet.moons}</p>
        <h2>Exploration</h2><p>{planet.mission}</p>
      </article>
      <aside class="planet-aside">
        <div class="card card-pad">
          <span class="eyebrow">Orbit & rotation</span>
          <h3>Rotation and orbit</h3>
          <dl class="fact-list">
            <div><dt>Semi-major axis · mean distance</dt><dd>{planet.distance}</dd></div>
            <div><dt>Orbital period</dt><dd>{planet.orbit}</dd></div>
            <div><dt>Sidereal rotation</dt><dd>{planet.rotation}</dd></div>
            <div><dt>Solar day</dt><dd>{planet.solarDay}</dd></div>
            <div><dt>Perihelion · closest</dt><dd>{planet.perihelion}</dd></div>
            <div><dt>Aphelion · farthest</dt><dd>{planet.aphelion}</dd></div>
            <div><dt>Orbital eccentricity</dt><dd>{planet.eccentricity}</dd></div>
            <div><dt>Inclination to ecliptic</dt><dd>{planet.inclination}</dd></div>
            <div><dt>Axial tilt</dt><dd>{planet.tilt}</dd></div>
            <div><dt>Mean temperature</dt><dd>{planet.temperature}</dd></div>
          </dl>
        </div>
        <div class="card card-pad">
          <span class="eyebrow">Physical profile</span>
          <h3>By the numbers</h3>
          <dl class="fact-list">
            <div><dt>Equatorial diameter</dt><dd>{planet.diameter}</dd></div>
            <div><dt>Mass</dt><dd>{planet.mass}</dd></div>
            <div><dt>Mean density</dt><dd>{planet.density}</dd></div>
            <div><dt>Equatorial gravity</dt><dd>{planet.gravity}</dd></div>
            <div><dt>Escape velocity</dt><dd>{planet.escapeVelocity}</dd></div>
          </dl>
        </div>
        <div class="callout"><strong>How to read the temperature</strong><p>For rocky planets, a mean temperature describes a surface average. For giant planets, there is no solid surface; the quoted value refers to a representative atmospheric level. Local conditions vary.</p></div>
      </aside>
    </div>
    <div class="source-panel">
      <div><span class="eyebrow">Evidence & attribution</span><h3>Sources and data notes</h3><p>Values are rounded for readability. Perihelion and aphelion distances are rounded to 0.1 million km; orbital inclination is measured relative to the ecliptic plane. Definitions and reference epochs matter when comparing datasets.</p></div>
      <ul class="source-list">
        <li><a href="https://ssd.jpl.nasa.gov/planets/phys_par.html" target="_blank" rel="noreferrer">NASA/JPL Solar System Dynamics — Planetary Physical Parameters ↗</a></li>
        <li><a href="https://nssdc.gsfc.nasa.gov/planetary/factsheet/" target="_blank" rel="noreferrer">NASA Space Science Data Coordinated Archive — Planetary Fact Sheet ↗</a></li>
        <li><a href={planet.imageSource} target="_blank" rel="noreferrer">NASA Science — {planet.name} image and overview ↗</a></li>
      </ul>
    </div>
    <nav class="planet-pagination" aria-label="Other planets">
      {previous ? <a class="page-step" href={"/planets/" + previous.slug + "/"}><span>← Previous planet</span><strong>{previous.name}</strong></a> : <span></span>}
      <a class="page-step next" href={next ? "/planets/" + next.slug + "/" : "/explore/"}><span>{next ? "Next planet →" : "Continue exploring →"}</span><strong>{next ? next.name : "Beyond the planets"}</strong></a>
    </nav>
  </section>
  <style>
    .planet-hero{padding-top:30px}.planet-hero h1{font-size:clamp(3.5rem,8vw,6.4rem)}.hero-chips{display:flex;flex-wrap:wrap;gap:8px;margin:25px 0}.hero-actions{display:flex;flex-wrap:wrap;gap:10px}.planet-feature-image{height:auto}.planet-feature-image .hero-image{height:340px;min-height:260px;border:0;border-radius:0}.planet-feature-image figcaption{background:#0c1524}
    .planet-stat-grid{margin-top:0}.planet-content-grid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(260px,.7fr);gap:45px;align-items:start}.planet-aside{display:grid;gap:15px;position:sticky;top:100px}.fact-list{display:grid;gap:0;margin:15px 0 0}.fact-list div{display:flex;justify-content:space-between;gap:12px;padding:11px 0;border-top:1px solid var(--line)}.fact-list dt{color:var(--quiet);font-size:.75rem}.fact-list dd{color:var(--text);font-size:.78rem;text-align:right;margin:0;font-weight:650}.source-panel{display:grid;grid-template-columns:.8fr 1.2fr;gap:35px;padding:26px;margin-top:60px;border:1px solid var(--line);border-radius:8px;background:rgba(16,27,45,.65)}.source-panel h3{margin:8px 0}.source-panel p{font-size:.82rem;line-height:1.7}.source-list{margin:0}.planet-pagination{display:flex;justify-content:space-between;gap:20px;margin-top:30px;padding-top:20px;border-top:1px solid var(--line)}.page-step{display:grid;gap:5px}.page-step span{font-size:.72rem;color:var(--quiet)}.page-step strong{font:600 1.25rem "Space Grotesk",sans-serif;color:var(--gold)}.page-step.next{text-align:right}
    @media(max-width:850px){.planet-content-grid{grid-template-columns:1fr}.planet-aside{position:static;grid-template-columns:repeat(2,1fr)}.source-panel{grid-template-columns:1fr}}
    @media(max-width:580px){.planet-aside{grid-template-columns:1fr}.planet-feature-image .hero-image{height:260px}.hero-actions .btn{width:100%}.planet-pagination{gap:10px}.page-step strong{font-size:1rem}}
  </style>
</SiteLayout>
